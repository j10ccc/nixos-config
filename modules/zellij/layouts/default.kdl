// 插件第一次加载时 zellij 会问权限：焦点切到状态栏按 y 授权一次（升级 wasm 后要再按）。
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left  "{mode}{tabs}"
                format_right "{command_sys}"
                format_space "#[bg=default]"

                // 只用终端 16 色名字，颜色跟着 ghostty 的 theme 走。
                mode_normal      "#[bg=bright_cyan,fg=black,bold] NORMAL#[bg=default,fg=bright_cyan] "
                mode_locked      "#[bg=bright_cyan,fg=black,bold] LOCKED#[bg=default,fg=bright_cyan] "
                mode_pane        "#[bg=bright_cyan,fg=black,bold] PANE#[bg=default,fg=bright_cyan] "
                mode_tab         "#[bg=bright_cyan,fg=black,bold] TAB#[bg=default,fg=bright_cyan] "
                mode_resize      "#[bg=bright_cyan,fg=black,bold] RESIZE#[bg=default,fg=bright_cyan] "
                mode_move        "#[bg=bright_cyan,fg=black,bold] MOVE#[bg=default,fg=bright_cyan] "
                mode_scroll      "#[bg=bright_cyan,fg=black,bold] SCROLL#[bg=default,fg=bright_cyan] "
                mode_search      "#[bg=bright_cyan,fg=black,bold] SEARCH#[bg=default,fg=bright_cyan] "
                mode_enter_search "#[bg=bright_cyan,fg=black,bold] ENTER SEARCH#[bg=default,fg=bright_cyan] "
                mode_rename_tab  "#[bg=bright_cyan,fg=black,bold] RENAME TAB#[bg=default,fg=bright_cyan] "
                mode_rename_pane "#[bg=bright_cyan,fg=black,bold] RENAME PANE#[bg=default,fg=bright_cyan] "
                mode_session     "#[bg=bright_cyan,fg=black,bold] SESSION#[bg=default,fg=bright_cyan] "
                mode_prompt      "#[bg=bright_cyan,fg=black,bold] PROMPT#[bg=default,fg=bright_cyan] "
                mode_tmux        "#[bg=bright_cyan,fg=black,bold] TMUX#[bg=default,fg=bright_cyan] "

                // 两端是 Nerd Font 的半圆 U+E0B6 / U+E0B4。
                tab_normal   "#[bg=default,fg=yellow]#[bg=yellow,fg=black]{index} #[bg=bright_cyan,fg=black] {name} #[bg=default,fg=bright_cyan] "
                tab_active   "#[bg=default,fg=blue]#[bg=blue,fg=bright_white,bold]{index} #[bg=bright_white,fg=black,bold] {name} #[bg=default,fg=bright_white] "

                // zjstatus 按空格切 argv 直接 exec，不过 shell，$HOME 要靠 sh 展开。
                command_sys_command    "/bin/sh -c $HOME/.local/bin/zellij-buddy"
                command_sys_format     "#[bg=default,fg=blue] {stdout} "
                command_sys_interval   "5"
                command_sys_rendermode "static"
            }
        }
    }
}
