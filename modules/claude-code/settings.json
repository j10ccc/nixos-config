{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "theme": "dark-ansi",
  "permissionMode": "bypassPermissions",
  "tui": "fullscreen",
  "model": "gemini-4-neon-medium",
  "modelPicker": {
    "replaceBuiltInOptions": true,
    "options": [
      { "model": "gemini-4-neon-medium", "label": "Gemini 4 Neon · medium" },
      { "model": "gemini-4-neon-high", "label": "Gemini 4 Neon · high" },
      { "model": "gemini-4-argon-medium", "label": "Gemini 4 Argon · medium" },
      { "model": "gemini-4-carbon-medium", "label": "Gemini 4 Carbon · medium" },
      { "model": "gemini-4-hydrogen-medium", "label": "Gemini 4 Hydrogen · medium" },
      { "model": "claude-opus-5-5-medium", "label": "Claude Opus 5.5 · medium", "behavesAs": "claude-opus-5-5" },
      { "model": "claude-sonnet-5-5-high", "label": "Claude Sonnet 5.5 · high", "behavesAs": "claude-sonnet-5-5" },
      { "model": "claude-sonnet-5-5-medium", "label": "Claude Sonnet 5.5 · medium", "behavesAs": "claude-sonnet-5-5" }
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_SOUND_NOTIFY"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_SOUND_STOP"
          }
        ]
      }
    ]
  },
  "env": {
    "SAFETY_NET_STRICT": "1",
    "SAFETY_NET_PARANOID_INTERPRETERS": "1",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "gemini-4-neon-medium",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "gemini-4-argon-medium",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "gemini-4-hydrogen-medium",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "gemini-4-carbon-medium"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*secret*)",
      "Read(**/*credentials*)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/op/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/config)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(bun publish:*)",
      "Bash(npm install -g:*)",
      "Bash(pnpm install -g:*)",
      "Bash(bun install -g:*)",
      "Bash(npm add -g:*)",
      "Bash(pnpm add -g:*)",
      "Bash(bun add -g:*)",
      "Bash(su:*)"
    ],
    "ask": [
      "Bash(sudo:*)",
      "Bash(npm install:*)",
      "Bash(bun install:*)",
      "Bash(npm add:*)",
      "Bash(pnpm add:*)",
      "Bash(bun add:*)",
      "Bash(brew install:*)",
      "WebFetch"
    ],
    "allow": [
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:support.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:*.github.io)"
    ]
  },
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "docker *"
    ],
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.config/op",
        "~/.config/gcloud",
        "~/.kube",
        "~/.netrc"
      ]
    },
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "codeload.github.com"
      ]
    }
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  }
}