{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "useGitignore": true,
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./.cspell/project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": [
    "bash",
    "node",
    "npm",
    "fonts",
    "filetypes",
    "softwareTerms",
    "project-words"
  ],
  "ignorePaths": [
    "modules/nvim/**",
    ".devbox/**",
    "**/*.lock"
  ]
}
